            <field name="name">Work Center Schedule</field>
            <field name="parent_id" ref="mrp.menu_mrp_manufacturing"/>
            <field name="action" ref="action_mrp_workcenter_gantt"/>
            <field name="sequence">20</field>
        </record>

    </data>
</odoo>
