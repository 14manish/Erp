<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Client action registered with the JS registry key -->
        <record id="action_mrp_workcenter_gantt" model="ir.actions.client">
            <field name="name">Work Center Schedule</field>
            <field name="tag">mrp_gantt_client_action</field>
            <field name="target">current</field>
        </record>

        <!-- Menu item under Manufacturing > Operations (mrp.menu_mrp_manufacturing = id 336) -->
