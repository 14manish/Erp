<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_gantt_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.gantt.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="gantt_workcenter_id" widget="selection"/>
                <field name="gantt_duration_expected" invisible="gantt_workcenter_id == False"/>
            </xpath>
        </field>
    </record>
</odoo>
