<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="wingspann_accounting.Dashboard" owl="1">
<div class="wd-dashboard">

    <div t-if="state.isLoading" class="wd-loading text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Loading financial data…</p>
    </div>

    <div t-else="">
        <!-- Header -->
        <div class="wd-header">
            <div>
                <h2 class="wd-title">Financial Overview</h2>
                <p class="wd-subtitle">Real-time accounting insights</p>
            </div>
            <div class="wd-header-actions">
                <button class="wd-btn-refresh" t-on-click="refreshNow" title="Refresh data now">
                    ↻ Refresh
                </button>
                <button class="wd-btn-invoice" t-on-click="createInvoice">
                    + Invoice
                </button>
                <button class="wd-btn-bill" t-on-click="createBill">
                    + Bill
                </button>
            </div>
        </div>

        <!-- Main Panels -->
        <div class="wd-main-panels">
            <!-- Left Panel -->
            <div class="wd-panel">
                <div class="wd-section-title">Financial Breakdown &amp; Balance</div>

                <!-- Allocated Budget Box -->
                <div class="wd-kpi-box">
                    <div class="wd-kpi-left">
                        <div class="wd-kpi-label">
                            Allocated Budget (<t t-esc="state.budgetData.fy_label"/>)
                            <button class="wd-btn-set-budget" t-on-click="setBudget" title="Edit budget">
                                ✏ Set Budget
                            </button>
                        </div>
                        <div class="wd-kpi-value"><t t-esc="formatCurrency(state.budgetData.allocated_budget)"/></div>
                    </div>
                    <div class="wd-kpi-right bg-teal-light">
                        <t t-esc="formatCurrency(state.budgetData.allocated_budget)"/>
                    </div>
                </div>

                <!-- Current Balance Box -->
                <div class="wd-kpi-box">
                    <div class="wd-kpi-left">
                        <div class="wd-kpi-label">Current Balance</div>
                        <div class="wd-kpi-value"><t t-esc="formatCurrency(state.budgetData.remaining_balance)"/></div>
                    </div>
                    <div class="wd-kpi-right bg-teal-lighter">
                        <t t-esc="formatCurrency(state.budgetData.remaining_balance)"/>
                    </div>
                </div>

                <!-- Expense Details Table -->
                <div class="wd-section-title">Expense Details</div>
                <table class="wd-expense-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Icon</th>
                            <th>Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.budgetData.expense_categories" t-as="cat" t-key="cat.name">
                            <tr>
                                <td><t t-esc="cat.name"/></td>
                                <td>
                                    <i t-att-class="'fa ' + (cat.icon || 'fa-circle')"/>
                                </td>
                                <td><t t-esc="formatCurrency(cat.amount)"/></td>
                            </tr>
                        </t>
                        <t t-if="state.budgetData.expense_categories.length === 0">
                            <tr>
                                <td colspan="3" class="text-center text-muted">No expenses found</td>
                            </tr>
                        </t>
                        <tr>
                            <td><strong>Total Expenses</strong></td>
                            <td></td>
                            <td><strong><t t-esc="formatCurrency(state.budgetData.total_expenses)"/></strong></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Balanced Ledger -->
                <div class="wd-section-title">Balanced Ledger</div>
                <div class="wd-ledger-desc">Balanced Commitment vs Allocation.</div>
                
                <div class="wd-ledger-grid">
                    <div class="wd-ledger-card" t-on-click="openPOList">
                        <div class="wd-ledger-label">Open PO Commitments</div>
                        <div class="wd-ledger-value"><t t-esc="formatCurrency(state.budgetData.po_commitment)"/></div>
                    </div>
                    <div class="wd-ledger-card" t-on-click="openPRList">
                        <div class="wd-ledger-label">Approved PR Commitments</div>
                        <div class="wd-ledger-value"><t t-esc="formatCurrency(state.budgetData.pr_commitment)"/></div>
                    </div>
                </div>
                
                <div class="wd-ledger-desc">Balanced Commitment vs Allocation.</div>
            </div>

            <!-- Right Panel -->
            <div class="wd-panel">
                <div class="wd-section-title">Budget vs. Expense Overview</div>
                
                <div class="wd-chart-container">
                    <canvas t-ref="budgetChart" class="wd-donut-canvas" t-on-click="onChartClick"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>
</t>
</templates>
