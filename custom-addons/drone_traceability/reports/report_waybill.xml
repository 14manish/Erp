<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_waybill" model="ir.actions.report">
        <field name="name">Print e-Way Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">drone_traceability.report_waybill_document</field>
        <field name="report_file">drone_traceability.report_waybill_document</field>
        <field name="print_report_name">'Waybill - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_waybill_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Arial', sans-serif; color: #000;">
                        <!-- e-Way Bill Header -->
                        <div class="text-center" style="margin-bottom: 20px;">
                            <h3 style="margin: 0; padding: 0;">e-Way Bill</h3>
                            <div style="margin-top: 10px;">
                                <!-- Simple QR Code Placeholder or Barcode -->
                                <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=100&amp;height=100' % o.x_ewaybill_no" style="width: 100px; height: 100px;" t-if="o.x_ewaybill_no"/>
                            </div>
                        </div>

                        <!-- Top Info Table -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 20px;">
                            <tr style="border-top: 1px solid #ccc; border-bottom: 1px solid #eee;">
                                <td style="width: 40%; padding: 8px;">E-Way Bill No:</td>
                                <td style="width: 60%; padding: 8px;"><strong><span t-field="o.x_ewaybill_no"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">E-Way Bill Date:</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_ewaybill_date"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Generated By:</td>
                                <td style="padding: 8px;"><strong><span t-field="o.company_id.vat"/> - <span t-field="o.company_id.name"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Valid From:</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_ewaybill_date"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Valid Until:</td>
                                <td style="padding: 8px;"><strong></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #ccc;">
                                <td style="padding: 8px;">Portal:</td>
                                <td style="padding: 8px;"><strong>1</strong></td>
                            </tr>
                        </table>

                        <!-- Part - A -->
                        <h5 style="background-color: #f5f5f5; padding: 5px; border-bottom: 1px solid #ccc; margin-top: 20px;">Part - A</h5>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 20px;">
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="width: 40%; padding: 8px;">GSTIN of Supplier</td>
                                <td style="width: 60%; padding: 8px;"><strong><span t-field="o.company_id.vat"/>,<span t-field="o.company_id.name"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Place of Dispatch</td>
                                <td style="padding: 8px;"><strong><span t-field="o.company_id.city"/>,<span t-field="o.company_id.state_id.name"/>-<span t-field="o.company_id.zip"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">GSTIN of Recipient</td>
                                <td style="padding: 8px;"><strong><span t-field="o.partner_id.vat"/> ,<span t-field="o.partner_id.name"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Place of Delivery</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_transportation_address"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Document No.</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_transport_doc_no"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Document Date</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_transport_doc_date"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Transaction Type:</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_transaction_type"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Value of Goods</td>
                                <td style="padding: 8px;"><strong><span t-field="o.amount_total"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">HSN Code</td>
                                <td style="padding: 8px;"><strong></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 8px;">Reason for Transportation</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_reason_for_transport"/></strong></td>
                            </tr>
                            <tr style="border-bottom: 1px solid #ccc;">
                                <td style="padding: 8px;">Transporter</td>
                                <td style="padding: 8px;"><strong><span t-field="o.x_transporter_name"/></strong></td>
                            </tr>
                        </table>

                        <!-- Part - B -->
                        <h5 style="background-color: #f5f5f5; padding: 5px; border-bottom: 1px solid #ccc; margin-top: 20px;">Part - B</h5>
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 20px; border: 1px solid #eee;">
                            <thead>
                                <tr style="border-bottom: 1px solid #ccc; background-color: #fafafa;">
                                    <th style="padding: 6px; border-right: 1px solid #eee;">Mode</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">Vehicle / Trans<br/>Doc No &amp; Dt.</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">From</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">Entered Date</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">Entered By</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">CEWB No.<br/>(If any)</th>
                                    <th style="padding: 6px; border-right: 1px solid #eee;">Multi Veh.Info<br/>(If any)</th>
                                    <th style="padding: 6px;">Portal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 6px; border-right: 1px solid #eee;">Road</td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;"><span t-field="o.x_vehicle_no"/></td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;"><span t-field="o.company_id.city"/></td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;"><span t-field="o.x_ewaybill_date"/></td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;"><span t-field="o.company_id.vat"/></td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;">-</td>
                                    <td style="padding: 6px; border-right: 1px solid #eee;">-</td>
                                    <td style="padding: 6px;">1</td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Barcode Placeholder -->
                        <div class="text-center" style="margin-top: 30px;">
                            <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=200&amp;height=50' % o.x_ewaybill_no" style="width: 200px; height: 50px;" t-if="o.x_ewaybill_no"/>
                            <div style="font-size: 10px; margin-top: 5px;"><span t-field="o.x_ewaybill_no"/></div>
                        </div>

                        <div style="font-size: 9px; margin-top: 40px; color: #555;">
                            Note*: If any discrepancy in information please try after sometimes.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
