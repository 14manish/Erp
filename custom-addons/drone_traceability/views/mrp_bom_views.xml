<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_inherit_drone_traceability" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.drone.traceability</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="product_serial_no" optional="show"/>
                <field name="model" optional="show"/>
                <!-- Description is usually the product name or internal reference, product_id shows name already -->
                <field name="component_trader" optional="show"/>
                <field name="country_of_origin" optional="show"/>
                <field name="weight" optional="show"/>
                <field name="unit_price" optional="show"/>
                <field name="total_price" optional="show"/>
                <field name="product_link" widget="url" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
