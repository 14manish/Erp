<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Move form view to hide UoM (Unit of Measure) column from invoice lines -->
    <record id="view_move_form_hide_uom" model="ir.ui.view">
        <field name="name">account.move.form.hide.uom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_uom_id'][@groups='uom.group_uom']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
