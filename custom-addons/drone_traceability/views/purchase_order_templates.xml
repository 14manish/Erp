<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_wingspann" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-family: 'Plus Jakarta Sans', sans-serif; color: #000; padding: 20px;">
                <!-- Custom CSS Styling inside the report -->
                <style>
                    .po-header {
                        display: flex;
                        align-items: center;
                        margin-bottom: 20px;
                    }
                    .po-title {
                        text-align: center;
                        font-weight: bold;
                        text-decoration: underline;
                        font-size: 22px;
                        margin: 20px 0;
                        color: #000;
                    }
                    .po-meta-box {
                        width: 100%;
                        border: 1px solid #000 !important;
                        margin-bottom: 15px;
                    }
                    .po-meta-box td {
                        border: none !important;
                        padding: 8px 12px;
                        vertical-align: top;
                        font-size: 13px;
                    }
                    .po-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 13px;
                        margin-bottom: 20px;
                    }
                    .po-table th, .po-table td {
                        border: 1px solid #000 !important;
                        padding: 6px 8px;
                        text-align: center;
                        vertical-align: middle;
                    }
                    .po-table th {
                        background-color: #f5f5f5;
                        font-weight: bold;
                    }
                    .po-table td.text-left {
                        text-align: left;
                    }
                    .po-table td.text-right {
                        text-align: right;
                    }
                    .po-totals {
                        width: 100%;
                        font-size: 13px;
                        margin-top: 10px;
                    }
                    .po-totals td {
                        padding: 4px 8px;
                    }
                    .po-terms {
                        font-size: 12px;
                        margin-top: 30px;
                        line-height: 1.4;
                    }
                    .po-footer {
                        text-align: center;
                        font-size: 11px;
                        margin-top: 50px;
                        border-top: 1px solid #ccc;
                        padding-top: 10px;
                        color: #555;
                    }
                </style>

                <!-- Header Section -->
                <div class="row po-header" style="align-items: center;">
                    <div class="col-4">
                        <img src="/drone_traceability/static/src/img/Icon.png" style="max-height: 85px;" alt="Wingspann Logo"/>
                    </div>
                    <div class="col-4 text-center" style="font-size: 13px; font-weight: bold; letter-spacing: 0.5px;">
                        OFFICIAL
                    </div>
                    <div class="col-4 text-right text-end" style="font-size: 13px; font-weight: bold; letter-spacing: 0.5px;">
                        STRICTLY CONFIDENTIAL
                    </div>
                </div>

                <!-- Title -->
                <div class="po-title">
                    PURCHASE ORDER
                </div>

                <!-- Meta Box -->
                <table class="po-meta-box">
                    <tr>
                        <td style="width: 50%; border-right: 1px solid #000 !important;">
                            <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            <t t-set="vat_source" t-value="o.partner_id.vat or o.partner_id.commercial_partner_id.vat"/>
                            <div t-if="vat_source" style="margin-top: 5px;"><strong>GSTIN : </strong> <span t-esc="vat_source"/></div>
                        </td>
                        <td style="width: 50%; padding-left: 15px;">
                            <strong>PO No : </strong> <span t-field="o.name"/><br/>
                            <strong>Date: </strong> <span t-field="o.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/><br/>
                            <strong>Ref – Your Quotation No </strong> <span t-field="o.x_quotation_ref"/><br/>
                            <t t-if="o.x_quotation_date">
                                <strong>Quotation Date: </strong> <span t-field="o.x_quotation_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Product Table -->
                <table class="po-table">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Services / Product</th>
                            <th style="width: 15%;">HSN/SAC Code</th>
                            <th style="width: 10%;">Quantity</th>
                            <th style="width: 10%;">Unit</th>
                            <th style="width: 10%;">Rate/Unit (Rs)</th>
                            <th style="width: 10%;">Total Amount (Rs)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_basic" t-value="0.0"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr>
                                <td class="text-left">
                                    <span t-field="line.name"/>
                                </td>
                                <td>
                                    <span t-field="line.x_hsn_code"/>
                                </td>
                                <td>
                                    <span t-field="line.product_qty" t-options='{"widget": "float", "precision": 0}'/>
                                </td>
                                <td>
                                    <span t-field="line.product_uom.name"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <t t-set="total_basic" t-value="total_basic + line.price_subtotal"/>
                        </t>
                        
                        <!-- Basic Total -->
                        <tr>
                            <td colspan="5" class="text-right" style="font-weight: bold;">Total Amount (Basic)</td>
                            <td class="text-right" style="font-weight: bold;">
                                <span t-esc="total_basic" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        
                        <!-- Tax Breakdown (CGST / SGST or IGST) -->
                        <t t-set="tax_amount" t-value="o.amount_tax"/>
                        <t t-set="has_igst" t-value="any('IGST' in t.name for t in o.order_line.mapped('taxes_id'))"/>
                        
                        <t t-if="has_igst">
                            <tr>
                                <td colspan="5" class="text-right" style="font-weight: bold;">IGST</td>
                                <td class="text-right" style="font-weight: bold;">
                                    <span t-esc="tax_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="5" class="text-right" style="font-weight: bold;">CGST</td>
                                <td class="text-right" style="font-weight: bold;">
                                    <span t-esc="tax_amount / 2" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-right" style="font-weight: bold;">SGST</td>
                                <td class="text-right" style="font-weight: bold;">
                                    <span t-esc="tax_amount / 2" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        
                        <!-- Grand Total -->
                        <tr>
                            <td colspan="5" class="text-right" style="font-weight: bold;">Total Amount (Inclusive of GST)</td>
                            <td class="text-right" style="font-weight: bold;">
                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        
                        <!-- Rounded Total -->
                        <tr>
                            <td colspan="5" class="text-right" style="font-weight: bold;">Rounded</td>
                            <td class="text-right" style="font-weight: bold;">
                                <span t-esc="round(o.amount_total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Amount in Words -->
                <div style="font-size: 13px; margin-bottom: 25px;">
                    <strong>Value in Words : </strong> <span t-esc="o.currency_id.amount_to_text(round(o.amount_total))"/>
                </div>

                <!-- Terms and Conditions -->
                <div class="po-terms">
                    <t t-if="o.notes">
                        <div style="margin-top: 15px;">
                            <strong>Payment &amp; Other Terms and Conditions:</strong>
                            <div t-field="o.notes"/>
                        </div>
                    </t>
                </div>

                <!-- Signatures Section -->
                <div style="width: 100%; margin-top: 60px; font-size: 13px; font-weight: bold; text-align: center;">
                    <table style="width: 100%; border-collapse: collapse; text-align: center;">
                        <tr>
                            <td style="width: 20%; padding: 0 5px;">
                                Prepared By<br/>
                                (Pranjal Chandekar)
                            </td>
                            <td style="width: 20%; padding: 0 5px;">
                                Finance Department<br/>
                                (Kalidas Shinde)
                            </td>
                            <td style="width: 20%; padding: 0 5px;">
                                Verified By<br/>
                                (Anil Deshmukh)
                            </td>
                            <td style="width: 20%; padding: 0 5px;">
                                Director<br/>
                                (Sandeep Patil)
                            </td>
                            <td style="width: 20%; padding: 0 5px;">
                                Director<br/>
                                (Prasad Sherkar)
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Footer Section -->
                <div class="po-footer">
                    <div>Wingspann Global Pvt Ltd, Gut No. 53 ,Plot 2 &amp; 3, Shajapur, MIDC Waluj, Aurangabad – 431136, Maharashtra, India</div>
                    <div>GSTIN 27AAECW2565K1ZX</div>
                    <div style="margin-top: 5px;">© Wingspann Global Private Limited, <span t-esc="o.date_order.year if o.date_order else 2026"/>. All rights reserved.</div>
                </div>
            </div>
        </xpath>
    </template>

