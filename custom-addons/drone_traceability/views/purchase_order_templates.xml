                            </t>
                            <t t-if="o.dest_address_id">
                                <strong>Shipping Address: </strong><span t-field="o.dest_address_id.name"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Product Table -->
                <table class="po-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Description</th>
