                            <th style="width: 20%;">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line" t-as="order_line">
                            <tr>
                                <td class="text-left">
                                    <span t-field="order_line.name"/>
                                </td>
                                <td>
                                    <span t-field="order_line.x_hsn_code"/>
                                </td>
                                <td>
                                    <span t-field="order_line.date_planned" t-options='{"widget": "datetime"}'/>
                                </td>
                                <td>
                                    <span t-field="order_line.product_qty"/>
                                    <span t-field="order_line.product_uom.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <t t-if="o.notes">
                    <div style="font-size: 13px; margin-top: 15px;">
                        <strong>Notes:</strong>
                        <div t-field="o.notes"/>
                    </div>
                </t>

                <!-- Footer Section -->
                <div class="po-footer">
                    <div>Wingspann Global Pvt Ltd, Gut No. 53 ,Plot 2 &amp; 3, Shajapur, MIDC Waluj, Aurangabad – 431136, Maharashtra, India</div>
                    <div>GSTIN 27AAECW2565K1ZX</div>
                    <div style="margin-top: 5px;">© Wingspann Global Private Limited, <span t-esc="o.date_order.year if o.date_order else 2026"/>. All rights reserved.</div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
