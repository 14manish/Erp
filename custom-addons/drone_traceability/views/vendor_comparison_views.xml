<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_comparison_wizard_form" model="ir.ui.view">
        <field name="name">vendor.comparison.wizard.form</field>
        <field name="model">vendor.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare Vendors">
                <group>
                    <field name="product_id" readonly="1" options="{'no_open': True}"/>
                    <field name="po_line_id" invisible="1"/>
                </group>
                <notebook>
                    <page string="Vendors">
                        <field name="line_ids" readonly="0">
                            <tree create="0" delete="0" editable="bottom">
                                <field name="partner_id" readonly="1"/>
                                <field name="min_qty" readonly="1"/>
                                <field name="delay" readonly="1"/>
                                <field name="price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                                <button name="action_use_price" string="Use Price" type="object" icon="fa-check" class="btn-primary" invisible="not parent.po_line_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
