<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Update Purchase Order Sequence -->
        <record id="purchase.seq_purchase_order" model="ir.sequence">
            <field name="prefix">WSGPL/[FY]/</field>
            <field name="padding">4</field>
        </record>

        <!-- Update Date Format for English (US) to DD/MM/YYYY -->
        <record id="base.lang_en" model="res.lang">
            <field name="date_format">%d/%m/%Y</field>
        </record>
    </data>
</odoo>
